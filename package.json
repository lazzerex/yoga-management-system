{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.includes('pnpm')) { console.error('This project uses pnpm. Please run: pnpm install'); process.exit(1); }\"",
        "build": "vite build",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.0.3",
        "axios": "^1.15.0",
        "bootstrap-icons": "^1.13.1",
        "vue": "^3.5.32",
        "vuedraggable": "^4.1.0",
        "ziggy-js": "^2.6.2"
    }
}
